; Engine configuration file.
; GoliathExplorer

config_version=5

[application]

config/name="GoliathExplorer"
config/description="Fly a ship around Goliath, a raymarched Schwarzschild black hole."
run/main_scene="res://menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://core/Globals.tscn"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

